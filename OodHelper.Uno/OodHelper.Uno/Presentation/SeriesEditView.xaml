<UserControl x:Class="OodHelper.Uno.Presentation.SeriesEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:OodHelper.Uno.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
  <UserControl.Resources>
    <conv:ShortDateConverter x:Key="ShortDate" />
  </UserControl.Resources>

  <Grid Width="480" Height="520" Padding="12" RowSpacing="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBox Grid.Row="0" Header="Series name"
             Text="{Binding Sname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

    <TextBox Grid.Row="1" Header="Discards profile"
             Text="{Binding Discards, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

    <TextBlock Grid.Row="2" Text="Member races" FontWeight="SemiBold" Margin="0,4,0,0" />

    <ListView Grid.Row="3"
              ItemsSource="{Binding Calendar}"
              BorderThickness="1"
              BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}">
      <ListView.ItemTemplate>
        <DataTemplate>
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Event}" />
            <TextBlock Grid.Column="1"
                       Text="{Binding StartDate, Converter={StaticResource ShortDate}}"
                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Edit races..." Command="{Binding EditRacesCommand}" />
      <Button Content="Save" Command="{Binding SaveCommand}" Style="{ThemeResource AccentButtonStyle}" />
      <Button Content="Cancel" Command="{Binding CancelCommand}" />
    </StackPanel>
  </Grid>
</UserControl>
